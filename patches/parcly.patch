diff --git a/lib/ui/screens/login/order_entry_test_screen.dart b/lib/ui/screens/login/order_entry_test_screen.dart
new file mode 100644
--- /dev/null
+++ b/lib/ui/screens/login/order_entry_test_screen.dart
@@ -0,0 +1,111 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:webview_flutter/webview_flutter.dart';
+
+/// Publicly referenced buyer entry points. These are unverified on-device and
+/// deliberately do not register an authenticated connector or import packages.
+const orderEntryTestUrls = <String, String>{
+  '小红书': 'https://www.xiaohongshu.com/order/list',
+};
+
+class OrderEntryTestScreen extends StatefulWidget {
+  final String platformName;
+  const OrderEntryTestScreen({super.key, required this.platformName});
+
+  @override
+  State<OrderEntryTestScreen> createState() => _OrderEntryTestScreenState();
+}
+
+class _OrderEntryTestScreenState extends State<OrderEntryTestScreen> {
+  late final WebViewController _controller;
+  late String _currentUrl;
+  int _progress = 0;
+  String? _message;
+
+  @override
+  void initState() {
+    super.initState();
+    _currentUrl = orderEntryTestUrls[widget.platformName]!;
+    _controller = WebViewController()
+      ..setJavaScriptMode(JavaScriptMode.unrestricted)
+      ..setNavigationDelegate(NavigationDelegate(
+        onProgress: (value) {
+          if (mounted) setState(() => _progress = value);
+        },
+        onUrlChange: (change) {
+          if (mounted && change.url != null) {
+            setState(() => _currentUrl = change.url!);
+          }
+        },
+        onNavigationRequest: (request) {
+          final uri = Uri.tryParse(request.url);
+          if (uri == null || !{'https', 'http'}.contains(uri.scheme)) {
+            if (mounted) {
+              setState(() => _message = '页面请求打开外部 App，已停留在网页。此入口可能依赖 App。');
+            }
+            return NavigationDecision.prevent;
+          }
+          return NavigationDecision.navigate;
+        },
+        onWebResourceError: (error) {
+          if (mounted && error.isForMainFrame == true) {
+            setState(() => _message = '页面加载失败（${error.errorCode}），可刷新重试。');
+          }
+        },
+      ))
+      ..loadRequest(Uri.parse(_currentUrl));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(
+        title: Text('${widget.platformName}订单页测试'),
+        actions: [
+          IconButton(
+            tooltip: '复制当前网址',
+            icon: const Icon(Icons.link),
+            onPressed: () async {
+              // The current address may contain account-specific query values;
+              // copy only on an explicit user action, never log or upload it.
+              await Clipboard.setData(ClipboardData(text: _currentUrl));
+              if (context.mounted) {
+                ScaffoldMessenger.of(context).showSnackBar(
+                  const SnackBar(content: Text('已复制网址；分享前请移除登录凭据等私人参数')),
+                );
+              }
+            },
+          ),
+          IconButton(
+            tooltip: '刷新',
+            icon: const Icon(Icons.refresh),
+            onPressed: () {
+              setState(() => _message = null);
+              _controller.reload();
+            },
+          ),
+        ],
+      ),
+      body: Column(children: [
+        const Padding(
+          padding: EdgeInsets.all(12),
+          child: Text('测试入口：请自行登录，检查能否显示订单和物流。暂不自动导入包裹。'),
+        ),
+        if (_message != null)
+          Padding(padding: const EdgeInsets.all(12), child: Text(_message!)),
+        if (_progress < 100) LinearProgressIndicator(value: _progress / 100),
+        Expanded(child: WebViewWidget(controller: _controller)),
+        SafeArea(
+          top: false,
+          child: TextButton.icon(
+            icon: const Icon(Icons.arrow_back),
+            label: const Text('网页内返回'),
+            onPressed: () async {
+              if (await _controller.canGoBack()) await _controller.goBack();
+            },
+          ),
+        ),
+      ]),
+    );
+  }
+}
